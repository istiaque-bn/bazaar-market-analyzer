# Template for the Docker Compose deployment (docker-compose.yml).
# Copy to .env.docker (gitignored) and fill in real values:
#   cp .env.docker.example .env.docker
# Always run compose with: docker compose --env-file .env.docker ...
# (the plain .env file in this repo is for native local dev — SQLite,
# no Docker — and must not be touched by this Docker setup.)

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated hostnames this deployment answers to.
ALLOWED_HOSTS=sma.is
CSRF_TRUSTED_ORIGINS=https://sma.is

# Exchange feature flags — omit both to get the default (DSE enabled,
# CSE disabled). Uncomment to change. See README.md's "Exchange feature
# flags" section — disabling CSE never deletes data, only stops new
# fetching/analysis/training for it.
# ENABLE_DSE=True
# ENABLE_CSE=False

# Hybrid automation — omit for the defaults shown (matches
# .env.production.example). See README.md's "Hybrid automation" section.
# CELERY_WORKER_CONCURRENCY=1
# CELERY_WORKER_PREFETCH_MULTIPLIER=1
# AUTO_MARKET_SYNC=True
# AUTO_SYNC_INTERVAL_MARKET=200
# AUTO_SYNC_INTERVAL_OFF=3600
# AUTO_INTRADAY_ANALYSIS=True
# AUTO_INTRADAY_ANALYSIS_INTERVAL=900
# AUTO_DAILY_APPEND=True
# AUTO_ANALYZE_AFTER_APPEND=True
# AUTO_CLOSE_LEARN=True
# AUTO_ML_TRAINING=True
# AUTO_ML_TRAINING_TIME=00:30

# Telegram ML daily report — see README.md's "Telegram ML daily report"
# section. Effectively inert until both TELEGRAM_BOT_TOKEN (below) and
# TELEGRAM_ADMIN_CHAT_ID are set.
# TELEGRAM_ML_DAILY_REPORT=True
# TELEGRAM_ML_REPORT_TIME=17:00
# TELEGRAM_ML_REPORT_TIMEZONE=Asia/Dhaka
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# Postgres — POSTGRES_HOST/PORT are hardcoded to the "db" service in
# docker-compose.yml itself; only the credentials come from here.
POSTGRES_DB=bazaar
POSTGRES_USER=bazaar
POSTGRES_PASSWORD=

# Required for the production Compose stack. From the Cloudflare Zero Trust
# dashboard: Networks -> Tunnels -> Create
# a tunnel -> Docker -> copy the token out of the `--token` argument in
# the sample command it shows you (see docs/DEPLOYMENT.md).
CLOUDFLARE_TUNNEL_TOKEN=
