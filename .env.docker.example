# Template for the Docker Compose deployment (docker-compose.yml).
# Copy to .env.docker (gitignored) and fill in real values:
#   cp .env.docker.example .env.docker
# Always run compose with: docker compose --env-file .env.docker ...
# (the plain .env file in this repo is for native local dev — SQLite,
# no Docker — and must not be touched by this Docker setup.)

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated hostnames this deployment answers to.
ALLOWED_HOSTS=sma.is
CSRF_TRUSTED_ORIGINS=https://sma.is

# Postgres — POSTGRES_HOST/PORT are hardcoded to the "db" service in
# docker-compose.yml itself; only the credentials come from here.
POSTGRES_DB=bazaar
POSTGRES_USER=bazaar
POSTGRES_PASSWORD=

# From the Cloudflare Zero Trust dashboard: Networks -> Tunnels -> Create
# a tunnel -> Docker -> copy the token out of the `--token` argument in
# the sample command it shows you (see docs/DEPLOYMENT.md).
CLOUDFLARE_TUNNEL_TOKEN=
