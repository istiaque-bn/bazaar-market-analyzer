# Local development (config/settings/development.py). For production, copy
# .env.production.example instead — this file's defaults are intentionally
# insecure/permissive and only safe on a developer's own machine.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Dhaka
# SQLite is hardcoded in development.py — no DATABASE_URL is read here.

# Exchange feature flags — which exchanges this deployment actively
# fetches/analyzes/serves. See README.md's "Exchange feature flags"
# section for the full behavior and re-enablement procedure. Note:
# development.py re-enables CSE by default regardless of this file, so
# local `runserver`/`manage.py test` keep exercising both exchanges
# unless you set ENABLE_CSE=False here yourself.
ENABLE_DSE=True
ENABLE_CSE=True
# MAINTENANCE_MODE=False

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Hybrid automation — see README.md's "Hybrid automation" section for the
# full architecture/schedule. Every flag disables independently; every
# interval is seconds and validated at startup (zero/negative/non-numeric
# fails clearly, not silently, via ImproperlyConfigured).
AUTO_MARKET_SYNC=True
AUTO_SYNC_INTERVAL_MARKET=120
AUTO_SYNC_INTERVAL_OFF=3600
AUTO_INTRADAY_ANALYSIS=True
AUTO_INTRADAY_ANALYSIS_INTERVAL=900
AUTO_DAILY_APPEND=True
AUTO_ANALYZE_AFTER_APPEND=True
AUTO_CLOSE_LEARN=True
AUTO_PAPER_TRADING=True           # autonomous virtual-only trading during the market window
AUTO_PAPER_TRADING_INTERVAL=900   # seconds between virtual decisions during 10:00-14:25
# Daily ML retrain, at a fixed off-hours time (well before the 10:00
# Asia/Dhaka market open, so it never collides with market hours).
AUTO_ML_TRAINING=True
AUTO_ML_TRAINING_TIME=00:30

# Conservative worker defaults for a small VM — see README's "Queues,
# locking, and concurrency".
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram ML daily report — one consolidated, plain-language ML status
# report to a single Admin recipient, once a day. Independently
# configurable from TELEGRAM_CHAT_ID above. See README.md's "Telegram ML
# daily report" section for setup, message format, and troubleshooting.
# Effectively inert (generates/previews fine, never sends) until both
# TELEGRAM_BOT_TOKEN (above) and TELEGRAM_ADMIN_CHAT_ID are set.
TELEGRAM_ML_DAILY_REPORT=True
TELEGRAM_ML_REPORT_TIME=17:00
TELEGRAM_ML_REPORT_TIMEZONE=Asia/Dhaka
TELEGRAM_ADMIN_CHAT_ID=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@bazaar.local
