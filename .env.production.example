# Production environment template (config/settings/production.py).
# Copy to a real secrets store (not into git) and fill in every value —
# production.py raises ImproperlyConfigured at startup if a required one
# is missing, a known placeholder, or otherwise looks unsafe.
#
#   DJANGO_SETTINGS_MODULE must be set to config.settings.production
#   for any of this to take effect — it is never the default.

DJANGO_SETTINGS_MODULE=config.settings.production

# --- Core ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# Comma-separated hostnames this deployment answers to (no scheme, no path).
ALLOWED_HOSTS=bazaar.example.com
# Comma-separated full origins (with scheme) allowed to submit cross-origin
# POSTs — usually the same hostname(s) as ALLOWED_HOSTS with https://.
CSRF_TRUSTED_ORIGINS=https://bazaar.example.com
TIME_ZONE=Asia/Dhaka

# --- Exchange feature flags --------------------------------------------
# Which exchanges this deployment actively fetches/analyzes/serves. DSE
# defaults to enabled and CSE defaults to disabled if these are left
# unset — a fresh production deployment with no override is DSE-only by
# default. This is an *operational* toggle, not data deletion: existing
# CSE data (stocks, price history, analyses, portfolio transactions)
# stays in the database untouched and becomes active again the moment
# ENABLE_CSE is flipped back to True and services are restarted. See
# README.md's "Exchange feature flags" section for the full behavior and
# the re-enablement/catch-up procedure.
ENABLE_DSE=True
ENABLE_CSE=False
# Escape hatch for a deliberate full-outage window (e.g. planned DB
# maintenance) — set True to take every exchange offline at once without
# startup refusing to boot for having zero enabled exchanges.
# MAINTENANCE_MODE=False

# --- HTTPS / proxy --------------------------------------------------------
# True if a reverse proxy/load balancer terminates TLS and forwards
# X-Forwarded-Proto (standard gunicorn-behind-nginx/ALB setup). Set False
# only if TLS is terminated by Django/gunicorn itself another way.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- CORS ------------------------------------------------------------------
# Comma-separated origins allowed to call the REST API cross-origin
# (e.g. a mobile app's web shell or a separate frontend domain). Leave
# blank to allow none.
CORS_ALLOWED_ORIGINS=

# --- Database: PostgreSQL --------------------------------------------------
# See docs/DEPLOYMENT.md for the documented SQLite -> PostgreSQL migration
# procedure. Nothing runs this automatically.
POSTGRES_DB=bazaar
POSTGRES_USER=bazaar
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=60

# --- Celery / Redis ---------------------------------------------------------
# Use rediss:// (TLS) with authentication, e.g.:
#   rediss://:PASSWORD@redis-host:6380/0
# Plaintext redis:// is refused at startup unless you explicitly set
# CELERY_BROKER_ALLOW_PLAINTEXT=True (only appropriate if the broker is
# reachable exclusively over a private network you control).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_BROKER_ALLOW_PLAINTEXT=False
CELERY_TASK_TIME_LIMIT=600
CELERY_TASK_SOFT_TIME_LIMIT=540
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
# Conservative defaults for a small VM (documented target: Oracle Cloud A1,
# 2 OCPUs, ~20 users) — see README's "Queues, locking, and concurrency".
# The worker container's -Q flag (docker-compose.yml) must still list all
# four queues regardless of concurrency — this only controls how many
# tasks run in parallel within that one worker process.
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# --- Notifications -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram ML daily report — separate from TELEGRAM_CHAT_ID above; see
# README.md's "Telegram ML daily report" section. Effectively inert
# (generates/previews fine, never sends) until both TELEGRAM_BOT_TOKEN
# and TELEGRAM_ADMIN_CHAT_ID are set.
TELEGRAM_ML_DAILY_REPORT=True
TELEGRAM_ML_REPORT_TIME=17:00
TELEGRAM_ML_REPORT_TIMEZONE=Asia/Dhaka
TELEGRAM_ADMIN_CHAT_ID=
# Operational alerts to the same private admin chat (deduplicated during
# the cooldown, so a persistent outage cannot spam Telegram every 5 minutes).
TELEGRAM_OPS_ALERTS=True
TELEGRAM_OPS_ALERT_COOLDOWN_MINUTES=360

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@bazaar.example.com

# --- Hybrid automation (same defaults as development; override if needed) --
# See README.md's "Hybrid automation" section for the full architecture,
# schedule, locking design, and monitoring/alerting behavior.
AUTO_MARKET_SYNC=True
AUTO_SYNC_INTERVAL_MARKET=200
AUTO_SYNC_INTERVAL_OFF=3600
AUTO_PAPER_TRADING=True           # no broker integration; stored predictions/prices only
AUTO_PAPER_TRADING_INTERVAL=900
AUTO_INTRADAY_ANALYSIS=True
AUTO_INTRADAY_ANALYSIS_INTERVAL=900
AUTO_DAILY_APPEND=True
AUTO_ANALYZE_AFTER_APPEND=True
AUTO_CLOSE_LEARN=True
# Daily ML retrain, at a fixed off-hours time (well before the 10:00
# Asia/Dhaka market open, so it never collides with market hours).
AUTO_ML_TRAINING=True
AUTO_ML_TRAINING_TIME=00:30

DJANGO_LOG_LEVEL=INFO

# --- Cloudflare named tunnel (Docker Compose deployment only) ------------
# Connector token from Cloudflare Zero Trust. Keep it in the host's private
# Compose environment file; never commit a populated value.
CLOUDFLARE_TUNNEL_TOKEN=
